class Solution {
  public:
    int largest(vector<int> &arr) {
        // code here
        int first = INT_MIN;
        int n = arr.size();
        for(int i = 0;i<n;i++)
        {
            if(arr[i]>first)
            {
                first = arr[i];
            }
        }
        return first;
    }
};

