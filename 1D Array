//Basic input output using array 
#include <iostream>
using namespace std;

int main() 
{
    int arr[5];
    for(int i = 0 ; i<=4;i++)
    {
      // cout<<"enter number"<<" "<<i+1<<endl;
      cin>>arr[i];
    }
    for(int i =0;i<=4;i++)
    {
      cout<<arr[i]<<" ";
    }
    return 0;
}
