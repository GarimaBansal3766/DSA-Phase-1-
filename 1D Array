//Ques: Leaders in an array (GFG) ?
class Solution {
  public:
    vector<int> leaders(vector<int>& arr) {
        // code here
        vector <int> ans;
        int n = arr.size();
        
        for(int i = 0;i<n ;i++)
        {
            int j ;
            for(j = i+1;j<n;j++)
            {
                if(arr[j]>arr[i])
                {
                    break;
                }
            }
            if(j==n)
            {
                ans.push_back(arr[i]);
            }
        }
        return ans;
    }
};
