//409. Longest Palindrome
class Solution {
public:
    int longestPalindrome(string s) {
        int n = s.length();
        int freq[256] = {0};
        long long count = 0;
        for(int i =0;i<n;i++)
        {
            freq[s[i]]++;
        }
        for(int i=0;i<255;i++)
        {
           if( freq[i]==1 && count == 0)
           {
            count+=1;
           }
           else if(freq[i]%2==0)
            {
            count= count + freq[i];
            }
            else if (freq[i]%2!=0 && count % 2 ==0 )
            {
                count= count + freq[i];
            }
            else if (freq[i]%2!=0)
            {
            count+=(freq[i]-1);
            }
        }
            return count;
    }
};
