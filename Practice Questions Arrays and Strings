//sort colors 001122
class Solution {
public:
    void sortColors(vector<int>& nums) {
    int l = 0;
    int m = 0;
    int h = nums.size()-1;
while(m<=h){
        if(nums[m]==2)
        {
        //swap with h
        int temp = nums[m];
        nums[m]=nums[h];
        nums[h]=temp;
        h--;
        m++;
        }
        else if(nums[m]==1)
        {
            m++;
        }     
        else{
            //swap with low
            int temp = nums[m];
            nums[m]=nums[l];
            nums[l]=temp;
            l++;
            m++;
        }
}
    }
};
