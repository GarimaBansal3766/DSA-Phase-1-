//Binary search to find target using recursion 
#include <iostream>
using namespace std;
int binary(int arr [], int target, int l, int h )
{
  if(l>h)
  {
    return -l ;
  }
  int mid = (l+h)/2;
  if(arr[mid]==target)
  {
    return mid;
  }
  else if(target>arr[mid])
  {
  return binary(arr,target,mid+1,h);
  }
  else{
     return binary(arr,target,l,mid-1);
  }
  
}
int main() 
{
  int arr[6] = {1,2,3,4,5,6};
  int l = 0;
  int h = 5;
 int index = binary(arr,4,l,h);
 cout<<index;
}
