// Function to calculate factorial of a number.
int Solve(int n)
{
    //base case
    if(n==1)
    {
        return 1 ;
    }
    //Recursive case 
    return n*Solve(n-1);
}
int factorial(int n) {
    // code here
    
    return Solve(n);
}
