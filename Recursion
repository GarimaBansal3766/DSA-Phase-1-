GFG reverse array using recursion
class Solution {
  public:
  void solve (vector<int> &arr, int i , int j)
  {
      if(i>=j)
        {
            return;
        }
        //swap
        int temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
        solve(arr,i+1,j-1);
        
  }
    void reverseArray(vector<int> &arr)
    {
        // code here
        int n = arr.size();
        int i = 0 ;
        int j = n-1;
        solve(arr,i,j);
    }
};
