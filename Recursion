//sum of digits (gfg)
class Solution {
    void sumSolve(int n , int &sum)
    {
        if(n==0)
        {
            return;
        }
        int a = n%10;
        sum = sum + a;
        sumSolve(n/10,sum);
    }
  public:
    int sumOfDigits(int n) {
        int sum = 0;
        sumSolve(n,sum);
        return sum;
    }
};
