/// Leetcode problem 257 Binary Tree paths
/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
    void solve(TreeNode *root, string path , vector<string> &ans)
    {
        if(root==NULL)
        {
            return;      //agar root null h mtlb kuch bhi nhi h to empty string jo initially pass ki h vo path mein print hogi 
            
        }
                            //agar root null nhi h mtlb kuch h to root ki jo value h usko string mein convert karke path mein daaldi 
        path+= to_string(root->val); 
                            // ab agr leaf node aa gaya mtlb left or right both null to jo pura path aaya usko ans array ke andar daaldo 
        if(root->left==NULL && root->right==NULL)
        {
            ans.push_back(path); /// 
        }
//verna root ke pehle left mein jaao or saath mein path le jaao phir if null to push path verna
        else{
            solve(root->left,path + "->",ans);
// verna right node me jaao or saath mein path le jaao phir wahi dono left right agar null ho gaye to path ko ans array mein push kardo 
            solve(root->right,path + "->",ans);
        }
    }
public:
    vector<string> binaryTreePaths(TreeNode* root) {
        vector<string> ans;
        solve(root,"",ans);
        return ans;
    }
};
