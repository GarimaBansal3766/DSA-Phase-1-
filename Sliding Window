class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int i = 0 ;
        int j = 0;
        int maxlen = 0;
        while(j<nums.size())
        {
            if(nums[j]==0)
            {
                k--;
            }
            while(k==-1)
            {
                if(nums[i]==0)
                {
                    k++;
                }
                i++;
            }
            maxlen = max(maxlen,j-i+1);
            j++;
        }
        return maxlen;
    }
};
