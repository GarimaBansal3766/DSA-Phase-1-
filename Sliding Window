///*********************************************************************
Max Sum Subarray of size k
class Solution {
  public:
    int maxSubarraySum(vector<int>& arr, int k) {
        // code here
        int i = 0 ; //window shrink 
        int j = 0 ;// window grow
        int curr_sum = 0 ;
        int max_sum = INT_MIN;
        int n = arr.size();
        
        while(j<n){
            curr_sum = curr_sum + arr[j];
        if(j-i+1<k)
        {
            j++;
        }
        else if (j-i+1==k)
        {
            max_sum = max(max_sum,curr_sum);
            curr_sum = curr_sum - arr[i];
            i++;
            j++;
        }
        }
        return max_sum;
    }
};
///****************************************************************************//
//Longest substring without repeating characters 
class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int left = 0;
        int length = 0;
        int maxlength = 0;
        set<char>* sets = new set<char>();
        for(int right = 0;right<s.length();right++)
        {
            while(sets->contains(s[right]))
            {
                sets->erase(s[left]);
                left++;
            }
            sets->insert(s[right]);
            length = right-left+1;
            if(length>=maxlength)
            {
                maxlength=length;
            }
        }
        return maxlength;
    }
};
///***************************************************************************//
class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int i = 0 ;
        int j = 0;
        int maxlen = 0;
        while(j<nums.size())
        {
            if(nums[j]==0)
            {
                k--;
            }
            while(k==-1)
            {
                if(nums[i]==0)
                {
                    k++;
                }
                i++;
            }
            maxlen = max(maxlen,j-i+1);
            j++;
        }
        return maxlen;
    }
};
