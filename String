//Valid anagram leetcode 242
class Solution {
public:
    bool isAnagram(string s, string t) {
        int i = 0;
        int j = 0;
        int freq[256] = {0};
        int freq1[256]={0};
        if(s.length()==t.length())
        {
            for(int i = 0;i<s.length();i++)
            {
                freq[s[i]]++;
            }
            for(int j=0;j<t.length();j++)
            {
                freq1[t[j]]++;
            }
            for(int i =0;i<256;i++)
            {
                if(freq[i]!=freq1[i])
                {
                    return false;
                }
            }
            return true;
        } 
        else{
            return false; 
        }
    }
};
