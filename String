//sort vowels in a string 
class Solution {
public:
    string sortVowels(string s) {
        string t; 
        int n = s.length();
        int m = t.length();
        for(int i = 0;i<n;)
        {
            if(s[i] == 'A' || s[i] == 'E' ||s[i] == 'I'||s[i] == 'O' ||s[i] == 'U' ||s[i] == 'a' ||s[i] == 'e' ||s[i] == 'i' ||s[i] == 'o' ||s[i] == 'u')
            {
                t+=s[i];
                i++;
            }
            else{
                i++;
            }
        }
        sort(t.begin(),t.end());
        int j = 0 ; 
        int k = 0 ; 
        while(j<n)
        {
            if(s[j] == 'A' || s[j] == 'E' ||s[j] == 'I'||s[j] == 'O' ||s[j] == 'U' ||s[j] == 'a' ||s[j] == 'e' ||s[j] == 'i' ||s[j] == 'o' ||s[j] == 'u')
            {
                s[j] = t[k];
                k++;
                j++;

            }
            else{
                j++;
            }
        }
        return s;
    }
};
