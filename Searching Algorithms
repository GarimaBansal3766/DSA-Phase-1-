//leetcode problem 34 Finding first and last position of element in sorted array 
class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        vector<int> arr;
        int first = Lowerbound(nums,target);
        int last = UpperBound(nums,target);
        arr.push_back(first);
        arr.push_back(last);
        return arr;
    }
        int Lowerbound(vector<int> nums , int target)
        {
        int s = 0 ,e = nums.size()-1, ans = -1;
        while(s<=e)
        {
            int mid = (s+e)/2;
            if(nums[mid] == target)
            {
                ans = mid;
                e = mid - 1;
            }
            else if(target>nums[mid])
            {
                 s = mid + 1;
            }
            else{
                e=mid -1;
            }
        }
        return ans;
    }
    int UpperBound(vector<int> nums , int target)
        {
        int s = 0, e = nums.size()-1,ans = -1;
        while(s<=e)
        {
            int mid = (s+e)/2;
            if(nums[mid] == target)
            {
                ans = mid;
                s = mid + 1;
               
            }
            else if(target>nums[mid])
            {
                 s = mid + 1;
            }
            else{
                e=mid -1;
            }
            
        }
        return ans ;
    }
};
