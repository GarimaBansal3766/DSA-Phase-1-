Bubble sort - swap two adjacent elements n times to take largest element at end one by one 
#include <iostream>
using namespace std;
///bubble sort O(n^2)
int main() 
{
  int n = 5;
  int arr[5]={5,4,3,2,1};
  for(int i = 0 ;i<n;i++)
  {
    for(int j = 0;j<=n-2;j++)
    {
      if(arr[j]>=arr[j+1])
      {
        swap(arr[j],arr[j+1]);
      }
    }
  }
  //display array
  for(int i = 0;i<5;i++)
  {
    cout<<arr[i]<<"";
  }
}
