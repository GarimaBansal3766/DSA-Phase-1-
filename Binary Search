///Leetcode problem 1011 capacity to ship packages within d days;
class Solution {
public:
bool ispossible(vector<int> &weights,int mid, int days)
{
    int d = 1;
    int shipload = 0;
    for(int i =0;i<weights.size();)
    {
        if(shipload+weights[i]<=mid)
        {
            shipload+=weights[i];
            i++;
        }
        else{
            d++;
            shipload=0;
        }
        if(d>days)
        {
            return false;
        }
    }
    return true;
}
    int shipWithinDays(vector<int>& weights, int days) {
        // create a new line number; 
        int n = weights.size();
        int sum = 0;
        int ans;
        for(int i = 0;i<=n-1;i++)
        {
            sum += weights[i];
        }
        int start = 1,end = sum;
        while(start<=end)
        {
            int mid = (start+end)/2;//at max mid capacity of a ship 
            if(ispossible(weights,mid,days))
            {
                ans = mid;
                end=mid-1;
            }
            else{
                start = mid+1;
            }
        }
        return ans;
    }
};
