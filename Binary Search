852. Peak Index in a Mountain Array
class Solution {
public:
    int peakIndexInMountainArray(vector<int>& arr) {
        int n = arr.size();
        int s = 0 ;
        int e = n-1;     
        while(s<=e)
        {
          int mid = (s+e)/2;
          if(arr[mid]<arr[mid+1])
          {
            s = mid+1;
          }
          else if(arr[mid-1]>arr[mid])
          {
            e = mid-1;
          }
          else if(arr[mid]>arr[mid+1])
          {
            return mid;
          }
          
        }
        return -1;
}
};
