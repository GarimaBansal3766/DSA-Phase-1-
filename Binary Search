Ques: Sqrt(x) (Leetcode) ?
class Solution {
public:
    int mySqrt(int x){
    long long high = x;
    long long low = 1;
    while(low<=high)
    {
        long long mid = (low + high)/2;
        if(mid * mid == x)
        {
            return mid;
        }
        else if (mid * mid > x)
        {
            //shift left 
            high = mid - 1;
        }
        else{
            low = mid+1;
        }
       
    }
 return low - 1;
    }
};
