//Ques: Valid Perfect Square (Leetcode) ?
class Solution {
public:
    bool isPerfectSquare(int num) {
        
        long long low = 1;
        long long high = num;

        while(low<=high)
        {
            long long mid = (high + low)  / 2 ;
            if(mid*mid==num)
            {
                return true;
            }
            else if (mid * mid > num)
            {
                high = mid -1  ;
            }
            else{
                low = mid + 1 ;
            }
        }
        return false;
    }
};
