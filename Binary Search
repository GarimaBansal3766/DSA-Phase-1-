//Magnetic force between 2 balls;
class Solution {
public:

bool ispossible(vector<int> &position, int mid , int m)
{
    int ball=1;
    int pos = position[0];
    for(int i = 1;i<position.size();i++)
    {
        if(position[i]-pos>=mid)
        {
            ball++;
            pos = position[i];
        }
        if(ball==m)
        {
            return true;
        }
    }
    return false;
}
    int maxDistance(vector<int>& position, int m) {
    int n = position.size();
    int ans; 
    sort(position.begin(),position.end());
    int s = 1; 
    int end = position[n-1];
    while(s<=end)
    {
        int mid=(s+end)/2;//atleast mid distance between 2 balls
        if(ispossible(position,mid,m))
        {
            ans = mid;
            s=mid+1;
        }else
        {
            end =  mid-1;
        }
    }
    return ans;
    }
};
