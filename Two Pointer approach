// User function template for C++
class Solution {
  public:
    vector<int> findSubarray(vector<int>& arr) {
        int n = arr.size();
        long long maxsum=0;
        int start = -1;
        int end = -1;
        long long  sum = 0;
        int currst =0;
        int currend=0;
        for(int i=0;i<n;i++)
        {
            if(arr[i]<0){
            sum = 0;
            currst = i+1;
            }
            else{
            
                sum+=arr[i];
                currend = i;
            
      if(sum>maxsum)
      {
          maxsum = sum ; 
          start = currst;
          end = currend;
      }
      else if(sum==maxsum&&(currend - currst + 1)>(end - start + 1))
      {
          start = currst;
          end = currend;
      }
          
      }
        
    }
    
    vector<int> ans;
    if(start == -1){
        ans.push_back(-1);
        return ans;
    }
    for(int i = start;i<=end;i++)
    {
        ans.push_back(arr[i]);
    }
    return ans ;
    }
};
