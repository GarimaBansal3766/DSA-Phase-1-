//Container with most water 
class Solution {
public:
    int maxArea(vector<int>& height) {
        int i =0;
        int j = height.size()-1;

        int area_max=INT_MIN;

        while(i<j)
        {
            int width = j-i;
            int h = min(height[j],height[i]);
            int area = width*h;
            if(height[i]>height[j])
            {
                j--;
            }
            else{
                i++;
            }
            if(area>area_max)
            {
                area_max = area;
            }
        }
        return area_max;
    }
};
