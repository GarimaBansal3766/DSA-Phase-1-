///Two Sum 
#include <iostream>
using namespace std;

int main() 
{
  int arr[] = {2,7,11,15};
  int n = 4 ; 
  int target = 9;
  for(int i = 0 ;i<n;i++)
  {
    for(int j = i+1;j<n;j++)
    {
      int sum = arr[i]+arr[j];
      if(sum==target)
      {
        cout<< i << " " << j;
        break;
      }
    }
  }
}
