GFG Insertion at a Given Position in a Linked List
class Solution {
  public:
    Node *insertPos(Node *head, int pos, int val) {
        // code here
        if(head==NULL||pos ==1)
        {
             Node *n = new Node(val);
             n->next=head;
             head = n;
             return head;
        }
        Node * temp;
        temp = head;
        Node *n = new Node(val);
        for(int i =1;i<pos-1;i++)
        {
            temp = temp->next;
        }
            Node * temp2 = temp-> next;
            temp->next = n;
            n->next = temp2;
        return head;
    }
    
};
