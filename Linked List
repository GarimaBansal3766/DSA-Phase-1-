///Linked List End Insertion
/*
class Node {
  public:
    int data;
    Node* next;
    Node(int data) {
        this->data = data;
        this->next = nullptr;
    }
};
*/
class Solution {
  public:
    Node *insertAtEnd(Node *head, int x) {
        // Code here
        if(head==NULL)
        {
            Node *n = new Node(x);
            head = n ;
        }
        else{
            Node* temp = head;
        while(temp-> next!=NULL)
        {
            temp = temp->next;
        }
        //New node to insert 
            Node *n = new Node(x);
            temp->next=n;
        }
        return head;
    }
};
