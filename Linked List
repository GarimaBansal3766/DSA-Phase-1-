GFG length of a linked list
class Solution {
  public:
    int getCount(Node* head) {
        // Code here
        int count = 1 ;
        Node *temp = head;
        while(temp->next!=NULL)
        {
            temp = temp->next;
            count++;
        }
        return count;
    }
};
