//Linked List Insertion At Beginning
/*
class Node {
  public:
    int data;
    Node *next;

    Node(int x) {
        data = x;
        next = NULL;
    }
};
*/

class Solution {
  public:
    Node *insertAtFront(Node *head, int x) {
        // Code here
        Node *n = new Node(x);
        if(head==NULL)
        {
            head = n;
        }
        Node *temp = head;
        head = n;
        n->next = temp;
        
        return head;
    }
};
